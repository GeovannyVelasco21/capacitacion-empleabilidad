# =============================================================
#  PLANTILLA DE SECRETS
#  En Streamlit Community Cloud copia esto en:
#  tu app → Settings → Secrets, y reemplaza los valores.
#  NO subas un secrets.toml con datos reales a GitHub.
# =============================================================

# --- Conexión con el Google Sheet (Apps Script) ---------------
# URL que te da Apps Script al hacer "Implementar" (termina en /exec)
apps_script_url = "https://script.google.com/macros/s/PEGA_AQUI_TU_ID/exec"
# La MISMA clave que escribiste en la línea TOKEN del script
apps_script_token = "CAMBIA_ESTA_CLAVE_SECRETA"

# --- Clave de acceso a la capacitación ------------------------
# Solo se usa si en config.py pones USAR_CLAVE_ACCESO = True
clave_acceso = "EscribeAquiTuClave"

# --- ALTERNATIVA: cuenta de servicio de Google ----------------
# Solo si NO usas Apps Script (borra las dos líneas apps_script_ de arriba)
# y tu cuenta permite crear llaves JSON. Quita los "#" para activarla.
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
# universe_domain = "googleapis.com"
